<h1>Sign Up</h1>

<%= form_with model: @user, url: users_path, local: true do |f| %>
  <fieldset>
    <legend>Create your account</legend>

    <div>
      <label for="user_email">Email</label>
      <%= f.email_field :email, id: "user_email", required: true, autofocus: true %>
    </div>

    <div>
      <label for="user_password">Password</label>
      <%= f.password_field :password, id: "user_password", required: true%>
    </div>

    <div>
      <label for="user_password">Password confirmation</label>
      <%= f.password_field :password_confirmation, id: "user_password_confirmation", required: true%>
    </div>

    <div>
      <%= f.submit "Sign Up"%>
    </div>
  </fieldset>
<% end %>
