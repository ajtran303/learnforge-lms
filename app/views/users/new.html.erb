<h1>Sign Up</h1>

<% if @user.errors.any? %>
  <section aria-labelledby="form-errors">
    <h2 id="form-errors"><%= pluralize(@user.errors.count, "error") %> prevented this account from being created:</h2>
    <ul>
      <% @user.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </section>
<% end %>

<%= form_with model: @user, url: users_path, local: true do |f| %>
  <fieldset>
    <legend>Create your account</legend>

    <div>
      <label for="user_email">Email</label>
      <%= f.email_field :email, id: "user_email", required: true, autofocus: true %>
    </div>

    <div>
      <label for="user_password">Password</label>
      <%= f.password_field :password, id: "user_password", required: true %>
    </div>

    <div>
      <label for="user_password_confirmation">Password confirmation</label>
      <%= f.password_field :password_confirmation, id: "user_password_confirmation", required: true %>
    </div>

    <div>
      <%= f.submit "Sign Up", data: { disable_with: nil } %>
    </div>
  </fieldset>
<% end %>
