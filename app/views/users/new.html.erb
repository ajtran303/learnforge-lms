<div class="container w-75">
  <h1 class="text-center mb-4">Sign Up</h1>

  <%# Server-side errors %>
  <% if @user.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @user, local: true do |f| %>
    <fieldset class="border p-4 rounded">
      <legend class="w-auto px-2">Create your account</legend>

      <div class="mb-3">
        <%= f.label :email, class: "form-label" %>
        <%= f.email_field :email, class: "form-control", value: @user.email, placeholder: "Enter your email", autofocus: true %>
      </div>

      <div class="mb-3">
        <%= f.label :password, class: "form-label" %>
        <%= f.password_field :password, class: "form-control", placeholder: "Enter a password (min 6 chars)" %>
      </div>

      <div class="mb-3">
        <%= f.label :password_confirmation, class: "form-label" %>
        <%= f.password_field :password_confirmation, class: "form-control", placeholder: "Confirm your password" %>
      </div>

      <div>
        <%= f.submit "Sign Up", class: "btn btn-primary w-100" %>
      </div>
    </fieldset>
  <% end %>
</div>
