<%= form_with model: lesson, url: lesson.persisted? ? course_lesson_path(lesson.course, lesson) : course_lessons_path(lesson.course), data: { turbo_frame: "lesson_form" } do |f| %>
  <fieldset class="border p-4 rounded">

  <legend><%= lesson.persisted? ? "Edit Lesson" : "Add Lesson" %></legend>
  <% if lesson.errors.any? %>
    <div class="errors">
      <ul>
        <% lesson.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :title, class: "form-label" %>
    <%= f.text_field :title, class: "form-control" %>
  </div>

  <div>
    <%= f.label :content, class: "form-label" %>
    <%= f.text_area :content, class: "form-control" %>
  </div>

  <%= f.submit lesson.persisted? ? "Update Lesson" : "Create Lesson", class: "btn btn-primary w-100" %>
  </fieldset>
<% end %>
<br>