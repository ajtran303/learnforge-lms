<%= form_with model: [@course, @lesson], local: true, data: { turbo_frame: "lesson_form" } do |f| %>
  <h3>Add Lesson</h3>
  <div>
    <%= f.label :title %>
    <%= f.text_field :title %>
  </div>

  <div>
    <%= f.label :content %>
    <%= f.text_area :content %>
  </div>

  <%= f.submit "Create Lesson" %>
<% end %>
