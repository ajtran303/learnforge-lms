<%= form_with model: lesson, url: lesson.persisted? ? course_lesson_path(lesson.course, lesson) : course_lessons_path(lesson.course), data: { turbo_frame: "lesson_form" } do |f| %>
  <h2><%= lesson.persisted? ? "Edit Lesson" : "Add Lesson" %></h2>
  <% if lesson.errors.any? %>
    <div class="errors">
      <ul>
        <% lesson.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :title %>
    <%= f.text_field :title %>
  </div>

  <div>
    <%= f.label :content %>
    <%= f.text_area :content %>
  </div>

  <%= f.submit lesson.persisted? ? "Update Lesson" : "Create Lesson" %>
<% end %>
