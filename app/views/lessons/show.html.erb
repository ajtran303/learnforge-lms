<div class="w-75 mx-auto">

<header class="course-header d-flex justify-content-around p-4">
  <h1 class="course-title my-auto"><%= @course.title %></h1>
  <%= render "shared/course_progress", course: @course, user: current_user %>
  <%= button_to "Back to Course Overview", course_path(@course), method: :get, class: "btn btn-primary h-100" %>
</header>

<div class="d-flex">
<aside class="lessons-sidebar" aria-label="Lesson navigation">
  <nav>
    <ul class="list-group">
      <% @course.lessons.order(:id).each do |lesson| %>
        <% if lesson == @lesson %>
          <li class="list-group-item active">
            <%= link_to lesson.title, course_lesson_show_path(@course, lesson), class: "text-light" %>
          </li>
        <% else %>
          <li class="list-group-item">
            <%= link_to lesson.title, course_lesson_show_path(@course, lesson) %>
          </li>
        <% end %>
      <% end %>
    </ul>
  </nav>
</aside>

<main class="lesson-content flex-fill ms-10 p-4" aria-labelledby="lesson-title">
  <turbo-frame id="lesson_title">
    <h2 id="lesson-title" class="text-center"><%= current_user.completed_lessons.include?(@lesson) ? "#{@lesson.title} - Completed" : @lesson.title %></h2>
  </turbo-frame>

  <article>
    <p class="p-4"><%= @lesson.content %></p>
  </article>

  <nav class="lesson-nav p-4" aria-label="Lesson navigation">
    <div class="prev-next d-flex justify-content-around">
      <% lessons = @course.lessons.order(:id).to_a %>
      <% index = lessons.index(@lesson) %>

      <% if index > 0 %>
        <%= button_to "Previous Lesson", course_lesson_show_path(@course, lessons[index - 1]), method: :get, class: "previous-lesson btn btn-primary flex-fill" %>
      <% end %>

      <% if index < lessons.length - 1 %>
        <%= button_to "Next Lesson", course_lesson_show_path(@course, lessons[index + 1]), method: :get, class: "next-lesson btn btn-primary flex-fill" %>
      <% end %>
    </div>
  </nav>

  <turbo-frame id="lesson_completion">
    <%= render "lessons/lesson_completion", lesson: @lesson %>
  </turbo-frame>

</main>
</div>
</div>
