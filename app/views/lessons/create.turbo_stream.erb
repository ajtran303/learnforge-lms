<%= turbo_stream.replace "flash" do %>
  <%= render "shared/flash" %>
<% end %>

<%= turbo_stream.update "lessons" do %>
  <%= render "lessons/lessons" %>
<% end %>

<%= turbo_stream.replace "lesson_form" do %>
  <turbo-frame id="lesson_form">
    <%= render "lessons/form", lesson: Lesson.new(course: @course) %>
  </turbo-frame>
<% end %>