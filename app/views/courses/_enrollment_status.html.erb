<% if current_user.enrolled_courses.include?(course) %>
  <p class="text-center">You are enrolled in this course.</p>

  <% lesson = next_uncompleted_lesson(course, current_user) || course.lessons.order(:id).first %>
  <%= button_to course_entry_label(course, current_user), course_lesson_show_path(course, lesson), method: :get, data: { turbo_frame: "_top" }, class: "btn btn-primary w-100" %>
  <%= button_to "Unenroll", unenroll_course_path(course), method: :delete, class: "btn btn-outline-danger w-100 mt-2" %>
<% else %>
  <p class="text-center">Enroll to view lessons</p>

  <%= button_to "Enroll", enroll_course_path(course), method: :post, class: "btn btn-primary w-100" %>
<% end %>
