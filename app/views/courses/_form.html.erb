<%= form_with model: course, local: true do |f| %>
  <% if course.errors.any? %>
    <div id="error_explanation">
      <% course.errors.full_messages.each do |message| %>
        <div class="alert alert-warning"><%= message %></div>
      <% end %>
    </div>
  <% end %>

  <fieldset class="border p-4 rounded">
    <legend>Course Details</legend>

    <div>
      <%= f.label :title, "Course Title", class: "form-label" %>
      <%= f.text_field :title, class: "form-control" %>
    </div>

    <div>
      <%= f.label :description, "Course Description", class: "form-label" %>
      <%= f.text_area :description, class: "form-control" %>
    </div>

    <div>
      <%= f.submit course.persisted? ? "Update Course" : "Create Course", class: "btn btn-primary w-100" %>
    </div>
  </fieldset>
<% end %>