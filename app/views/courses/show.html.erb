<div class="container w-75 mx-auto">

<h1 class="text-center"><%= @course.title %></h1>
<p class="text-center"><%= @course.description %></p>

<% if current_user&.instructor? %>
  <div class="d-flex justify-content-center">
    <p class="me-4 mt-3 mb-3">Status: <%= @course.status.capitalize %></p>
    <% if @course.draft? %>
      <%= button_to "Publish", publish_course_path(@course), method: :patch, class: "btn btn-primary h-100 ms-4" %>
    <% else %>
      <%= button_to "Unpublish", unpublish_course_path(@course), method: :patch, class: "btn btn-secondary h-100 ms-4" %>
    <% end %>
  </div>
  <br>

  <turbo-frame id="lesson_form">
    <%= render "lessons/form", lesson: Lesson.new(course: @course) %>
  </turbo-frame>


  <div id="flash">
    <%= render "shared/flash" %>
  </div>
<% end %>

<% if current_user.role == "learner" %>
  <p class="text-center"><strong>Instructor:</strong> <%= @course.user.email %></p>

  <% if current_user.enrolled_courses.include?(@course) %>
    <p>You are already enrolled in this course.</p>

    <%= render "shared/course_progress", course: @course, user: current_user %><br>

    <% lesson = next_uncompleted_lesson(@course, current_user) || @course.lessons.order(:id).first %>
    <%= button_to course_entry_label(@course, current_user), course_lesson_show_path(@course, lesson), method: :get, class: "btn btn-primary w-100" %>
  <% else %>
    <%= button_to "Enroll in this Course", enroll_course_path(@course), method: :post, class: "btn btn-primary w-100" %>
  <% end %>
<% end %>

<h2 class="text-center">Lessons</h2>

<turbo-frame id="lessons">
  <%= render "lessons/lessons", lessons: @course.lessons %>
</turbo-frame>

</div>
