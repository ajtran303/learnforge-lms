<h1><%= @course.title %></h1>
<p><%= @course.description %></p>
<p><strong>Instructor:</strong> <%= @course.user.email %></p>

<div id="flash">
  <%= notice %>
</div>

<% if current_user&.instructor? %>
  <p>Status: <%= @course.status %></p>
  <% if @course.draft? %>
    <%= button_to "Publish", publish_course_path(@course), method: :patch %>
  <% else %>
    <%= button_to "Unpublish", unpublish_course_path(@course), method: :patch %>
  <% end %>

  <turbo-frame id="lesson_form">
    <%= render "lessons/form", lesson: Lesson.new(course: @course) %>
  </turbo-frame>
<% end %>

<% if current_user.role == "learner" %>
  <% if current_user.enrolled_courses.include?(@course) %>
    <p>You are already enrolled in this course.</p>

    <%= render "shared/course_progress", course: @course, user: current_user %>

    <% lesson = next_uncompleted_lesson(@course, current_user) || @course.lessons.order(:id).first %>
    <%= link_to course_entry_label(@course, current_user), course_lesson_show_path(@course, lesson) %>
  <% else %>
    <%= button_to "Enroll in this Course", enroll_course_path(@course), method: :post %>
  <% end %>
<% end %>

<h2>Lessons</h2>

<div id="flash">
  <%= render "shared/flash" %>
</div>

<% if flash[:lesson_deleted] %>
  <p class="flash lesson-deleted"><%= flash[:lesson_deleted] %></p>
<% end %>

<turbo-frame id="lessons">
  <%= render "lessons/lessons", lessons: @course.lessons %>
</turbo-frame>
