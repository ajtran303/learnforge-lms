<div class="container mx-auto">

<h1 class="p-2 text-center">Sign In</h1>

<%= render "shared/flash" %>

<%= form_with url: session_path, local: true do |f| %>
  <fieldset class="border p-4 rounded">

    <legend class="p-2 text-center">Log into your account</legend>

    <div class="container mx-auto">

      <div class="p-2 d-flex flex-column">
        <label for="user_email" class="pb-1 form-label">Email</label>
        <%= f.email_field :email, id: :user_email, class: "form-control" %>
      </div>

      <div class="p-2 d-flex flex-column">
        <label for="user_password" class="pb-1 form-label">Password</label>
        <%= f.password_field :password, id: :user_password, class: "form-control" %>
      </div>

      <div>
        <%= f.submit "Sign In", data: { disable_with: nil }, class: "p-2 btn btn-primary w-100" %>
      </div>
    </div>

  </fieldset>
<% end %>

<div class="p-2 text-center">
  Not registered? <%= link_to "Sign up!", new_user_registration_path %>
</div>

</div>
