<h1>Sign In</h1>

<%= form_with url: session_path, local: true do |f| %>
  <fieldset>
    <legend>Log into your account</legend>

    <div>
      <label for="user_email">Email</label>
      <%= f.email_field :email, id: :user_email, required: true %>
    </div>

    <div>
      <label for="user_password">Password</label>
      <%= f.password_field :password, id: :user_password, required: true %>
    </div>

    <div>
      <%= f.submit "Sign In", data: { disable_with: nil } %>
    </div>
  </fieldset>
<% end %>

<div>
  Not registered? <%= link_to "Sign up!", new_user_registration_path %>
</div>

<% if flash[:alert] %>
  <p class="alert"><%= flash[:alert] %></p>
<% end %>

<% if flash[:notice] %>
  <p class="notice"><%= flash[:notice] %></p>
<% end %>
