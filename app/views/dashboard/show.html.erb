<% if flash[:alert] %>
  <div class="alert alert-success w-75 mx-auto"><%= flash[:alert] %></div>
<% end %>


<% if flash[:notice] %>
  <div class="alert alert-success w-75 mx-auto><%= flash[:notice] %></div>
<% end %>

<% if current_user.role == "instructor" %>
  <h1 class="text-center w-75 mx-auto">Instructor Dashboard</h1>
  <div class="container">

    <ul class="w-75 mx-auto list-group list-group-flush">
      <% current_user.courses.each do |course| %>
        <li class="p-2 list-group-item">
          <strong><%= link_to course.title, course_path(course) %></strong><br>
          <em><%= course.description %></em><br>
          <p>Status: <%= course.status %></p>
          <%= link_to "Edit", edit_course_path(course) %>
          <%= button_to "Delete", course_path(course),
              method: :delete,
              data: { turbo_confirm: "Are you sure you want to delete this course?" } %>
        </li>
      <% end %>
    </ul>

    <div class="text-center">
      <%= link_to "Create Course", new_course_path, class: "btn btn-primary w-75" %>
    </div>
  </div>


<% elsif current_user.role == "learner" %>
  <h1 class="text-center w-75 mx-auto">Available Courses</h1>
  <ul class="w-75 mx-auto list-group list-group-flush">
    <% @courses.each do |course| %>
      <li class="p-2 list-group-item">
        <strong><%= link_to course.title, course_path(course) %></strong><br>
        <em><%= course.description %></em><br>
        <p><strong>Instructor:</strong> <%= course.user.email %></p>
        <%= render "shared/course_progress", course: course, user: current_user %>
      </li>
    <% end %>
  </ul>
<% end %>
