<% if flash[:alert] %>
  <div class="alert alert-success w-75 mx-auto"><%= flash[:alert] %></div>
<% end %>


<% if flash[:notice] %>
  <div class="alert alert-info w-75 mx-auto"><%= flash[:notice] %></div>
<% end %>

<% if current_user.role == "instructor" %>
  <h1 class="text-center w-75 mx-auto">Instructor Dashboard</h1>
  <div class="container">
  
    <% if current_user.courses.any? { |course| course.published?}  %>
      <h2 class="text-center w-75 mx-auto">Published Courses</h2>
    <% end %>

    <ul class="w-75 mx-auto list-group">
      <% current_user.courses.each do |course| %>
        <% if course.status == "published" %>
          <li class="p-2 list-group-item">
            <strong><%= course.title %></strong><br>
            <em><%= course.description %></em><br><br>
            <div class="d-flex justify-content-between">

              <%= link_to "Add/Edit Lessons", course_path(course), class: "btn btn-primary" %>
              <%= link_to "Edit Course Details", edit_course_path(course), class: "btn btn-secondary" %>
              <%= button_to "Unpublish", unpublish_course_path(course), method: :patch, class: "btn btn-warning h-100" %>
              <%= button_to "Delete", course_path(course),
                  method: :delete,
                  data: { turbo_confirm: "Are you sure you want to delete this course?" },
                  class: "btn btn-danger h-100" %>
            </div>
          </li>
        <% end %>
      <% end %>
    </ul>
    <br>
    <% if current_user.courses.any? { |course| course.draft?}  %>
      <h2 class="text-center w-75 mx-auto">Draft Courses</h2>
    <% end %>

    <ul class="w-75 mx-auto list-group">
      <% current_user.courses.each do |course| %>
        <% if course.status == "draft" %>
          <li class="p-2 list-group-item">
            <strong><%= course.title %></strong><br>
            <em><%= course.description %></em><br><br>
            <div class="d-flex justify-content-between">

              <%= link_to "Add/Edit Lessons", course_path(course), class: "btn btn-primary" %>
              <%= link_to "Edit Course Details", edit_course_path(course), class: "btn btn-secondary" %>
              <%= button_to "Publish", publish_course_path(course), method: :patch, class: "btn btn-warning h-100" %>
              <%= button_to "Delete", course_path(course),
                  method: :delete,
                  data: { turbo_confirm: "Are you sure you want to delete this course?" },
                  class: "btn btn-danger h-100" %>
            </div>
          </li>
        <% end %>
      <% end %>
    </ul>

    <div class="text-center">
      <%= link_to "Create Course", new_course_path, class: "btn btn-primary w-75" %>
    </div>
  </div>


<% elsif current_user.role == "learner" %>
  <h1 class="text-center w-75 mx-auto">Learner Dashboard</h1>
  <h2 class="text-center w-75 mx-auto">Available Courses</h2>
  <ul class="w-75 mx-auto list-group list-group">
    <% @courses.each do |course| %>
      <li class="p-2 list-group-item">
        <strong><%= link_to course.title, course_path(course) %></strong><br>
        <em><%= course.description %></em><br>
        <p><strong>Instructor:</strong> <%= course.user.email %></p>
        <%= render "shared/course_progress", course: course, user: current_user %>
      </li>
    <% end %>
  </ul>
<% end %>
